# ==============================================================================
# CAMPUS OS — SERVER CONFIGURATION (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Cloud Configuration
SUPABASE_URL=https://rqeojxdkbxhonskmuykc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string (from Supabase Database Settings)
# Used for DDL migrations, connection pooling, and pgvector operations
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini Official SDK Configuration
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Session & JWT Configuration
JWT_SECRET=super-secure-random-jwt-secret-key-32-chars-min
