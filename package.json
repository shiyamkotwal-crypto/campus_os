{
  "name": "campus-os",
  "version": "1.0.0",
  "description": "CAMPUS OS — AI-Powered Unified Campus Intelligence Platform",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "supabase"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "migrate": "npm run migrate --workspace=supabase"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "campus-os",
    "higher-education",
    "gemini",
    "rag",
    "supabase",
    "react",
    "express",
    "typescript"
  ],
  "author": "CAMPUS OS Engineering Team",
  "license": "MIT"
}

